[Unit]
Description=Rufpass automatic callback permissions for FRITZ!Box
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=rufpass
Group=rufpass
ExecStart=/opt/rufpass/current/bin/rufpass run --config /etc/rufpass/config.toml
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
StateDirectory=rufpass
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
